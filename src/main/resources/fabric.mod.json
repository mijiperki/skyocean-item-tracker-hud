{
  "schemaVersion": 1,
  "id": "multicraft",
  "version": "${version}",
  "name": "MultiCraft Helper",
  "description": "Track multiple Hypixel SkyBlock craft recipe trees on screen at once. Reimplements the single-item Craft Helper and lets you keep several active simultaneously.",
  "authors": ["tperkins"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.tperkins.multicraft.MultiCraftClient"
      }
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.0",
    "minecraft": "~26.1"
  }
}
